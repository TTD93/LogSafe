#!/usr/bin/env ruby
# frozen_string_literal: true

require "logsafe"
require "tempfile"
require "tmpdir"

USAGE = <<~TEXT
  logsafe key                               prints a new key
  logsafe decrypt FILE | gzip -dc           prints a day's file
  logsafe decrypt STREAM YYYY-MM-DD PART…   prints the lines of these parts of that stream and day
  The key to decrypt with comes from LOGSAFE_KEY, and keys that were in use before from LOGSAFE_OLD_KEYS.
TEXT

begin
  use_keys = lambda do
    Logsafe.key = ENV.fetch("LOGSAFE_KEY") { abort "Set LOGSAFE_KEY to the key the logs were encrypted with." }
    Logsafe.old_keys = ENV.fetch("LOGSAFE_OLD_KEYS", nil)
  end
  case ARGV
  in ["key"]
    puts Logsafe.generate_key
  in ["decrypt", file]
    use_keys.call
    # Into a file first: nothing is printed before the whole file has been checked.
    Tempfile.create("logsafe") do |gzip|
      Logsafe.decrypt(file, gzip.path)
      IO.copy_stream(gzip.path, $stdout)
    end
  in ["decrypt", stream, day, *parts] if parts.any? && day.match?(Logsafe::DATE)
    use_keys.call
    source = Logsafe::Source.new(stream, day, Logsafe.keys)
    # Each part by itself, so that one that cannot be read, or that ends in the middle of a line, takes
    # nothing from the others.
    read = parts.map do |part|
      Dir.mktmpdir("logsafe") do |dir|
        FileUtils.cp(part, copy = File.join(dir, "part"))
        source.part(copy)
        IO.copy_stream(copy, $stdout)
      end
    rescue Logsafe::Error => e
      warn "#{part}: #{e.message}"
    end
    exit 1 unless read.all?
  else
    abort USAGE
  end
rescue Logsafe::Error, SystemCallError => e
  abort e.message
end
